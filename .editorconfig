root = true

# Matches the ruff settings in pyproject.toml: spaces, LF, final newline.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
